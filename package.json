{
  "name": "tidal-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for TidalCycles live coding - enables Claude AI to control Tidal through conversational interaction",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tidal-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:websocket": "./start-websocket.sh",
    "start:ws": "TIDAL_TRANSPORT=websocket node dist/index.js",
    "test:websocket": "node test-websocket-client.js",
    "prepare": "npm run build",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "typecheck:tidal": "tsx scripts/typecheck-tidal.ts"
  },
  "keywords": [
    "tidalcycles",
    "tidal",
    "live-coding",
    "livecoding",
    "mcp",
    "model-context-protocol",
    "algorave",
    "music",
    "supercollider",
    "superdirt",
    "algorithmic-composition",
    "ai-music",
    "claude",
    "anthropic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Benedict/tidal-cycles-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/Benedict/tidal-cycles-mcp-server/issues"
  },
  "homepage": "https://github.com/Benedict/tidal-cycles-mcp-server#readme",
  "author": "Benedict Steele",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0"
  }
}
